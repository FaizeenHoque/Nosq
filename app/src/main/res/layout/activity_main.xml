<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/textView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="80dp"
        android:fontFamily="@font/ndot_57_aligned"
        android:includeFontPadding="false"
        android:letterSpacing="-0.02"
        android:lineHeight="72sp"
        android:text="NOS"
        android:textAlignment="viewStart"
        android:textColor="?attr/colorOnBackground"
        android:textSize="72sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/textView2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/ndot_57_aligned"
        android:includeFontPadding="false"
        android:letterSpacing="-0.02"
        android:lineHeight="72sp"
        android:text="QURAN"
        android:textAlignment="viewStart"
        android:textColor="?attr/colorOnBackground"
        android:textSize="72sp"
        app:layout_constraintStart_toStartOf="@+id/textView"
        app:layout_constraintTop_toBottomOf="@+id/textView" />

    <!-- Hijri month -->
    <TextView
        android:id="@+id/textView3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="2dp"
        android:fontFamily="@font/ndot_57_aligned"
        android:includeFontPadding="false"
        android:lineHeight="36sp"
        android:text="25"
        android:textAlignment="viewEnd"
        android:textColor="?attr/colorOnBackground"
        android:textSize="32sp"
        app:layout_constraintBottom_toTopOf="@+id/textView4"
        app:layout_constraintEnd_toEndOf="@+id/textView6" />

    <TextView
        android:id="@+id/textView4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="2dp"
        android:fontFamily="@font/geist_variable"
        android:fontVariationSettings="'wght' 500"
        android:includeFontPadding="false"
        android:letterSpacing="0.06"
        android:lineHeight="16sp"
        android:text="Jumada al-Ula"
        android:textAlignment="viewEnd"
        android:textAllCaps="true"
        android:textColor="?android:attr/textColorTertiary"
        android:textSize="11sp"
        app:layout_constraintBottom_toTopOf="@+id/textView5"
        app:layout_constraintEnd_toEndOf="@+id/textView6" />

    <!-- Hijri year -->
    <TextView
        android:id="@+id/textView5"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="2dp"
        android:fontFamily="@font/geist_variable"
        android:fontVariationSettings="'wght' 500"
        android:includeFontPadding="false"
        android:letterSpacing="0.06"
        android:lineHeight="16sp"
        android:text="1448 AH"
        android:textAlignment="viewEnd"
        android:textAllCaps="true"
        android:textColor="?android:attr/textColorTertiary"
        android:textSize="11sp"
        app:layout_constraintBottom_toTopOf="@+id/textView6"
        app:layout_constraintEnd_toEndOf="@+id/textView6" />

    <!-- Gregorian date -->
    <TextView
        android:id="@+id/textView6"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="8dp"
        android:fontFamily="@font/geist_variable"
        android:fontVariationSettings="'wght' 500"
        android:includeFontPadding="false"
        android:letterSpacing="0.06"
        android:lineHeight="16sp"
        android:text="Thu 05 Nov"
        android:textAlignment="viewEnd"
        android:textAllCaps="true"
        android:textColor="?android:attr/textColorTertiary"
        android:textSize="11sp"
        app:layout_constraintBottom_toBottomOf="@+id/textView2"
        app:layout_constraintEnd_toEndOf="parent" />



</androidx.constraintlayout.widget.ConstraintLayout>
<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/textView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="80dp"
        android:fontFamily="@font/ndot_57_aligned"
        android:includeFontPadding="false"
        android:letterSpacing="-0.02"
        android:lineHeight="72sp"
        android:text="NOS"
        android:textAlignment="viewStart"
        android:textColor="?attr/colorOnBackground"
        android:textSize="72sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/textView2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/ndot_57_aligned"
        android:includeFontPadding="false"
        android:letterSpacing="-0.02"
        android:lineHeight="72sp"
        android:text="QURAN"
        android:textAlignment="viewStart"
        android:textColor="?attr/colorOnBackground"
        android:textSize="72sp"
        app:layout_constraintStart_toStartOf="@+id/textView"
        app:layout_constraintTop_toBottomOf="@+id/textView" />

    <!-- Hijri day -->
    <TextView
        android:id="@+id/textView3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="2dp"
        android:fontFamily="@font/ndot_57_aligned"
        android:includeFontPadding="false"
        android:lineHeight="36sp"
        android:text="25"
        android:textAlignment="viewEnd"
        android:textColor="?attr/colorOnBackground"
        android:textSize="32sp"
        app:layout_constraintBottom_toTopOf="@+id/textView4"
        app:layout_constraintEnd_toEndOf="@+id/textView6" />

    <!-- Hijri month -->
    <TextView
        android:id="@+id/textView4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="2dp"
        android:fontFamily="@font/geist_variable"
        android:fontVariationSettings="'wght' 500"
        android:includeFontPadding="false"
        android:letterSpacing="0.06"
        android:lineHeight="16sp"
        android:text="Jumada al-Ula"
        android:textAlignment="viewEnd"
        android:textAllCaps="true"
        android:textColor="?android:attr/textColorTertiary"
        android:textSize="11sp"
        app:layout_constraintBottom_toTopOf="@+id/textView5"
        app:layout_constraintEnd_toEndOf="@+id/textView6" />

    <!-- Hijri year -->
    <TextView
        android:id="@+id/textView5"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="2dp"
        android:fontFamily="@font/geist_variable"
        android:fontVariationSettings="'wght' 500"
        android:includeFontPadding="false"
        android:letterSpacing="0.06"
        android:lineHeight="16sp"
        android:text="1448 AH"
        android:textAlignment="viewEnd"
        android:textAllCaps="true"
        android:textColor="?android:attr/textColorTertiary"
        android:textSize="11sp"
        app:layout_constraintBottom_toTopOf="@+id/textView6"
        app:layout_constraintEnd_toEndOf="@+id/textView6" />

    <!-- Gregorian date -->
    <TextView
        android:id="@+id/textView6"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="8dp"
        android:fontFamily="@font/geist_variable"
        android:fontVariationSettings="'wght' 500"
        android:includeFontPadding="false"
        android:letterSpacing="0.06"
        android:lineHeight="16sp"
        android:text="Thu 05 Nov"
        android:textAlignment="viewEnd"
        android:textAllCaps="true"
        android:textColor="?android:attr/textColorTertiary"
        android:textSize="11sp"
        app:layout_constraintBottom_toBottomOf="@+id/textView2"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Continue reading -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/continueReadingCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_continue_reading"
        android:clickable="true"
        android:contentDescription="Continue reading Al-Kahf, verse 10 of 110"
        android:focusable="true"
        android:padding="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView2">

        <TextView
            android:id="@+id/continueLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/geist_variable"
            android:fontVariationSettings="'wght' 500"
            android:includeFontPadding="false"
            android:letterSpacing="0.06"
            android:lineHeight="16sp"
            android:text="Continue reading"
            android:textAllCaps="true"
            android:textColor="@color/inverse_secondary"
            android:textSize="11sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/continueChevron"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_chevron_right"
            app:layout_constraintBottom_toBottomOf="@+id/continueLabel"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/continueLabel" />

        <TextView
            android:id="@+id/verseReference"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/ndot_57_aligned"
            android:includeFontPadding="false"
            android:letterSpacing="-0.01"
            android:lineHeight="50sp"
            android:text="18:10"
            android:textColor="@color/inverse_text"
            android:textSize="48sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/continueLabel" />

        <TextView
            android:id="@+id/surahName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/geist_variable"
            android:fontVariationSettings="'wght' 500"
            android:includeFontPadding="false"
            android:letterSpacing="-0.005"
            android:lineHeight="28sp"
            android:text="Al-Kahf"
            android:textColor="@color/inverse_text"
            android:textSize="22sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/verseReference" />

        <TextView
            android:id="@+id/surahMeta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/geist_variable"
            android:includeFontPadding="false"
            android:lineHeight="16sp"
            android:text="The Cave · Verse 10 of 110"
            android:textColor="@color/inverse_secondary"
            android:textSize="12sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/surahName" />

        <TextView
            android:id="@+id/surahNameArabic"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/amiriquran_regular"
            android:lineHeight="68sp"
            android:text="الكهف"
            android:textColor="@color/inverse_text"
            android:textDirection="rtl"
            android:textSize="32sp"
            app:layout_constraintBottom_toBottomOf="@+id/surahMeta"
            app:layout_constraintEnd_toEndOf="parent" />

        <dev.faizeenhoque.nosquran.DotProgressView
            android:id="@+id/verseDots"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/surahMeta" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>